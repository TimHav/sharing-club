#: admin-options.php:133 sharing-club.php:146
msgid "Sharing Club"
msgstr "Sharing Club"

#. Plugin URI of the plugin
#: sharing-club.php
msgid "https://wordpress.org/plugins/sharing-club/"
msgstr "https://wordpress.org/plugins/sharing-club/"

#. Description of the plugin
#: sharing-club.php
msgid ""
"Share books, dvd, tools, toys or any object with your community. Your users "
"can easily lend, borrow and rate items and you know who borrowed what."
msgstr ""
"Deel boeken, DVDs, werktuigen, speelgoed of om het even welk object met je "
"vrienden of gemeenschap. Je gebruikers kunnen gemakkelijk uitlene, lenen en "
"een waardering geven aan spullen terwijl jij kan opvolgen wat er gedeeld "
"wordt en wie wat geleend heeft."

